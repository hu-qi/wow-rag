# Copy this file to backend/.env and fill in your own values.

# Required: API key for your OpenAI-compatible chat and embedding service.
WOWRAG_API_KEY=your_api_key_here

# Optional: OpenAI-compatible base URL.
# Default in code: https://open.bigmodel.cn/api/paas/v4
WOWRAG_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional: model names.
WOWRAG_CHAT_MODEL=glm-4-flash
WOWRAG_EMBED_MODEL=embedding-3

# Optional: local document and vector store settings.
WOWRAG_DOCS_PATH=../docs/问答手册.txt
WOWRAG_QDRANT_PATH=qdrant
WOWRAG_QDRANT_COLLECTION=wenda
